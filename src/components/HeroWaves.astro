</div>

<style>
  .hero-waves {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(680px, 62%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-waves svg { display: block; width: 100%; height: 100%; max-width: none; }
  :global([data-theme='dark']) .hero-waves { opacity: 0.75; }
  @media (max-width: 767px) { .hero-waves { width: 70%; opacity: 0.55; } }
  @media (max-width: 479px) { .hero-waves { display: none; } }
</style>
