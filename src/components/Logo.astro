---
import { withBase } from '../utils/url';
interface Props { href?: string }
const { href = withBase('/') } = Astro.props;
---

<a class="logo" href={href} aria-label="mq, home">
  <span class="logo-text" aria-hidden="true">mq</span>
  <svg class="logo-swoosh" viewBox="0 0 64 12" aria-hidden="true" focusable="false">
    <path d="M3 8.5 C14 3.5 34 3 61 6.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    <path d="M16 10.8 C28 8.4 42 8.2 52 9.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity=".55" />
  </svg>
</a>

<style>
  .logo {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: var(--logo-color);
    text-decoration: none;
    line-height: 1;
    padding: 2px 4px;
    border-radius: var(--radius-sm);
  }
  .logo:hover { color: var(--logo-color); }
  .logo-text {
    font-family: var(--font-logo);
    font-weight: 700;
    font-size: 48px;
    line-height: 0.9;
    letter-spacing: -0.02em;
    display: inline-block;
    transform: skewX(-8deg) rotate(-3deg);
    transform-origin: left bottom;
  }
  .logo-swoosh {
    width: 53px;
    height: 10px;
    margin-top: -2px;
    transform: rotate(-2deg);
  }
  @media (max-width: 479px) {
    .logo-text { font-size: 40px; }
    .logo-swoosh { width: 44px; }
  }
</style>
