---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/url';

interface Props { active?: 'posts' | 'tags' | 'me' | null }
const { active = null } = Astro.props;

const links = [
  { key: 'posts', label: 'Posts', href: withBase('/') },
  { key: 'tags', label: 'Tags', href: withBase('/tags/') },
  { key: 'me', label: 'Me', href: withBase('/me/') },
];
---

<header class="navbar">
  <div class="navbar-inner">
    <Logo />
    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={['nav-link', { active: active === l.key }]} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <span class="divider" aria-hidden="true"></span>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--navbar-height);
    background: var(--navbar-bg);
    box-shadow: 0 1px 0 var(--border);
  }
  .navbar::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 2px;
    background: var(--gradient-brand);
  }
  .navbar-inner {
    height: 100%;
    max-width: var(--container-width);
    margin-inline: auto;
    padding-inline: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .nav { display: flex; align-items: center; gap: 12px; }
  ul { list-style: none; display: flex; align-items: center; gap: 8px; margin: 0; padding: 0; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 18px;
    border-radius: var(--radius-full);
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    color: var(--text-primary);
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }
  .nav-link:hover { background: var(--surface-secondary); color: var(--text-primary); }
  .nav-link.active, .nav-link.active:hover { background: var(--accent-soft); color: var(--accent-text); }
  .divider { width: 1px; height: 24px; background: var(--border); margin: 0 4px; }

  @media (max-width: 1279px) { .navbar-inner { padding-inline: 24px; } }
  @media (max-width: 767px) {
    .nav { gap: 6px; }
    ul { gap: 2px; }
    .nav-link { padding: 0 12px; font-size: 15px; }
  }
  @media (max-width: 479px) {
    .navbar-inner { padding-inline: 12px; gap: 8px; }
    .nav-link { padding: 0 9px; font-size: 14px; height: 32px; }
    .divider { display: none; }
  }
</style>
