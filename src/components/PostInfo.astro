---
import Icon from './Icon.astro';
import TagPill from './TagPill.astro';
import { formatDate, readingMinutes, tagSlug, type Post } from '../utils/posts';
import { withBase } from '../utils/url';

interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
---
<section class="info card">
  <h2 class="section-title"><Icon name="Info" size={20} class="info-icon" /> Post Info</h2>
  <dl>
    <div class="row"><dt><Icon name="FolderOpen" size={16} /> Category</dt>
      <dd><a href={withBase(`/tags/${tagSlug(d.category)}/`)}>{d.category}</a></dd></div>
    {d.tags.length > 0 && (
      <div class="row"><dt><Icon name="Tag" size={16} /> Tags</dt>
        <dd class="pills">{d.tags.map((t) => <TagPill label={t} variant="secondary" href={withBase(`/tags/${tagSlug(t)}/`)} />)}</dd></div>
    )}
    {d.difficulty && (
      <div class="row"><dt><Icon name="ChartNoAxesColumn" size={16} /> Difficulty</dt>
        <dd class="accent">{d.difficulty}</dd></div>
    )}
    {d.event && <div class="row"><dt><Icon name="Flag" size={16} /> Event</dt><dd>{d.event}</dd></div>}
    {d.points != null && <div class="row"><dt><Icon name="Trophy" size={16} /> Points</dt><dd>{d.points}</dd></div>}
    <div class="row"><dt><Icon name="CalendarDays" size={16} /> Published</dt>
      <dd><time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time></dd></div>
    {d.updatedDate && (
      <div class="row"><dt><Icon name="CalendarClock" size={16} /> Updated</dt>
        <dd><time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time></dd></div>
    )}
    <div class="row"><dt><Icon name="Clock" size={16} /> Read time</dt><dd>~ {readingMinutes(post)} min</dd></div>
  </dl>
</section>

<style>
  .info { padding: 16px; }
  .section-title { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-size: 18px; font-weight: 700; color: var(--text-primary); }
  .info :global(.info-icon) { color: var(--accent); }
  dl { margin: 0; }
  .row { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 8px; padding: 6px 0; font-size: 14px; align-items: center; line-height: 1.4; }
  dt { display: flex; align-items: center; gap: 8px; color: var(--text-muted); }
  dd { margin: 0; color: var(--text-primary); min-width: 0; overflow-wrap: anywhere; }
  dd a { color: var(--text-primary); text-decoration: none; }
  dd a:hover { color: var(--link); text-decoration: underline; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .accent { color: var(--accent); font-weight: 600; }
</style>
