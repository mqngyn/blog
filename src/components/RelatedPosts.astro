---
import Icon from './Icon.astro';
import { formatDate, postUrl, type Post } from '../utils/posts';

interface Props { posts: Post[] }
const { posts } = Astro.props;
---
{posts.length > 0 && (
  <section class="related card">
    <h2 class="section-title"><Icon name="Layers" size={20} class="rel-icon" /> Related Posts</h2>
    <ul>
      {posts.map((p) => (
        <li>
          <a href={postUrl(p)}>
            <span class="text">
              <span class="title">{p.data.title}</span>
              <span class="sub">{formatDate(p.data.pubDate)} · {p.data.category}</span>
            </span>
            <Icon name="ChevronRight" size={18} class="chev" />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related { padding: 16px; }
  .section-title { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; font-size: 18px; font-weight: 700; color: var(--text-primary); }
  .related :global(.rel-icon) { color: var(--accent); }
  ul { list-style: none; margin: 0; padding: 0; }
  li + li { border-top: 1px solid var(--border); }
  a { display: flex; align-items: center; gap: 12px; padding: 10px 0; text-decoration: none; }
  .text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .title { color: var(--link); font-size: 14px; font-weight: 500; line-height: 1.4; }
  a:hover .title { color: var(--link-hover); text-decoration: underline; }
  .sub { color: var(--text-muted); font-size: 12px; }
  .related :global(.chev) { color: var(--text-muted); flex: none; }
</style>
