---
import Icon from './Icon.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'desktop' | 'mobile';
}
const { headings, variant = 'desktop' } = Astro.props;

interface Node { h: MarkdownHeading; children: MarkdownHeading[] }
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const tree: Node[] = [];
for (const h of items) {
  if (h.depth === 2 || tree.length === 0) tree.push({ h, children: [] });
  else tree[tree.length - 1].children.push(h);
}
const mobile = variant === 'mobile';
---
{tree.length > 0 && (
  mobile ? (
    <details class="toc toc-mobile card">
      <summary>
        <Icon name="ListTree" size={18} class="toc-icon" />
        <span>Table of Contents</span>
        <Icon name="ChevronDown" size={18} class="toc-chevron" />
      </summary>
      <nav aria-label="Table of contents (mobile)">
        <ol class="toc-list">
          {tree.map(({ h, children }) => (
            <li>
              <a class="toc-link" href={`#${h.slug}`}><span class="dot" aria-hidden="true"></span>{h.text}</a>
              {children.length > 0 && (
                <ol class="toc-sub">
                  {children.map((c) => (
                    <li><a class="toc-link toc-link-sub" href={`#${c.slug}`}><span class="dot" aria-hidden="true"></span>{c.text}</a></li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : (
    <section class="toc card">
      <h2 class="section-title toc-title"><Icon name="ListTree" size={20} class="toc-icon" /> Table of Contents</h2>
      <nav aria-label="Table of contents">
        <ol class="toc-list">
          {tree.map(({ h, children }) => (
            <li>
              <a class="toc-link" href={`#${h.slug}`}><span class="dot" aria-hidden="true"></span>{h.text}</a>
              {children.length > 0 && (
                <ol class="toc-sub">
                  {children.map((c) => (
                    <li><a class="toc-link toc-link-sub" href={`#${c.slug}`}><span class="dot" aria-hidden="true"></span>{c.text}</a></li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>
    </section>
  )
)}

<style>
  .toc { padding: 16px; }
  .toc-title { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-size: 18px; font-weight: 700; color: var(--text-primary); }
  .toc :global(.toc-icon) { color: var(--accent); flex: none; }
  .toc-list, .toc-sub { list-style: none; margin: 0; padding: 0; }
  .toc-sub { margin: 2px 0 4px 18px; }
  .toc-link {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 6px 10px; border-radius: var(--radius-md);
    color: var(--text-secondary); text-decoration: none;
    font-size: 14px; line-height: 1.4; font-weight: 500;
    transition: background var(--transition), color var(--transition);
  }
  .toc-link-sub { font-size: 13px; font-weight: 400; }
  .toc-link:hover { color: var(--text-primary); background: var(--surface-secondary); }
  .dot {
    flex: none; width: 8px; height: 8px; margin-top: 6px; border-radius: 50%;
    border: 1.5px solid var(--text-muted); box-sizing: border-box;
  }
  .toc-link.is-active { background: var(--accent-soft); color: var(--accent-text); font-weight: 600; }
  .toc-link.is-active .dot { background: var(--accent); border-color: var(--accent); }

  .toc-mobile { padding: 0; }
  .toc-mobile summary {
    display: flex; align-items: center; gap: 10px; cursor: pointer;
    padding: 12px 16px; font-weight: 700; font-size: 16px; list-style: none;
  }
  .toc-mobile summary::-webkit-details-marker { display: none; }
  .toc-mobile summary span { flex: 1; }
  .toc-mobile :global(.toc-chevron) { transition: transform var(--transition); color: var(--text-muted); }
  .toc-mobile[open] :global(.toc-chevron) { transform: rotate(180deg); }
  .toc-mobile nav { padding: 0 12px 12px; }
</style>
