---
interface Props {
  label: string;
  variant?: 'category' | 'secondary' | 'tag';
  href?: string;
  size?: 'sm' | 'md';
}
const { label, variant = 'tag', href, size = 'sm' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag href={href} class:list={['pill', `pill-${variant}`, `pill-${size}`, { 'pill-link': !!href }]}>{label}</Tag>

<style>
  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    white-space: nowrap;
    background: var(--accent-soft);
    color: var(--accent-text);
    transition: filter var(--transition), background var(--transition);
  }
  .pill-md { padding: 4px 14px; font-size: 14px; }
  .pill-category { background: #15803d; color: #fff; }
  .pill-secondary { background: #dbeafe; color: #1d4ed8; }
  :global([data-theme='dark']) .pill-category { background: #166534; color: #dcfce7; }
  :global([data-theme='dark']) .pill-secondary { background: var(--blue-soft); color: var(--blue-text); }
  .pill-link { cursor: pointer; }
  .pill-link:hover { filter: brightness(0.95); }
  .pill-category.pill-link:hover { color: #fff; }
  :global([data-theme='dark']) .pill-link:hover { filter: brightness(1.15); }
  .pill-tag.pill-link:hover { color: var(--accent-text); }
  .pill-secondary.pill-link:hover { color: #1d4ed8; }
  :global([data-theme='dark']) .pill-secondary.pill-link:hover { color: var(--blue-text); }
</style>
