---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Post } from '../utils/posts';

interface Props {
  post: Post;
  width?: number;
  height?: number;
}
const { post, width = 224, height = 150 } = Astro.props;
const { thumbnail, thumbnailAlt, category, title } = post.data;

const c = category.toLowerCase();
const icon = c.includes('crypto') ? 'KeyRound' : c.includes('ctf') ? 'Flag' : c.includes('web') ? 'Globe' : 'FileText';
const uid = `g-${post.id.replace(/[^a-z0-9]/gi, '')}`;
---

<div class="thumb" style={`--w:${width}px`}>
  {thumbnail ? (
    <Image src={thumbnail} alt={thumbnailAlt ?? title} width={width * 2} height={height * 2} loading="lazy" class="thumb-img" />
  ) : (
    <div class="thumb-fallback" aria-hidden="true">
      <svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" focusable="false">
        <defs>
          <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#052e1c" />
            <stop offset="0.55" stop-color="#0b5d49" />
            <stop offset="1" stop-color="#0f766e" />
          </linearGradient>
          <pattern id={`${uid}-grid`} width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M20 0H0V20" fill="none" stroke="#a7f3d0" stroke-opacity=".12" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="300" height="200" fill={`url(#${uid}-bg)`} />
        <rect width="300" height="200" fill={`url(#${uid}-grid)`} />
        <circle cx="260" cy="30" r="60" fill="#38bdf8" opacity=".12" />
        <circle cx="30" cy="190" r="70" fill="#22c55e" opacity=".12" />
      </svg>
      <span class="thumb-icon"><Icon name={icon} size={44} /></span>
    </div>
  )}
</div>

<style>
  .thumb {
    position: relative;
    width: 100%;
    max-width: var(--w);
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-secondary);
  }
  .thumb :global(.thumb-img) { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 0; }
  .thumb-fallback { position: absolute; inset: 0; }
  .thumb-fallback svg { display: block; width: 100%; height: 100%; max-width: none; }
  .thumb-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #bbf7d0;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 0.35));
  }
  .thumb-icon :global(svg) { stroke-width: 1.5; }
</style>
